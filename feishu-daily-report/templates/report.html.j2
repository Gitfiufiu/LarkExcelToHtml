<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI助手问题单日报</title>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
      margin: 24px;
      background: #ffffff;
      color: #1f2329;
      line-height: 1.6;
    }
    header {
      margin-bottom: 16px;
    }
    h2 {
      margin: 0 0 6px 0;
      font-size: 18px;
      font-weight: 600;
    }
    .meta {
      color: #646a73;
      font-size: 12px;
    }
    .table-wrap {
      overflow: auto;
      border: 1px solid #e5e6eb;
      border-radius: 6px;
    }
    table {
      border-collapse: collapse;
      width: 100%;
      min-width: 1100px;
      font-size: 13px;
    }
    thead th {
      position: sticky;
      top: 0;
      background: #f7f8fa;
      border: 1px solid #d0d3d6;
      padding: 8px 10px;
      text-align: left;
      white-space: nowrap;
      font-weight: 600;
      z-index: 1;
    }
    tbody td {
      border: 1px solid #e5e6eb;
      padding: 8px 10px;
      word-break: break-word;
      white-space: pre-wrap;
      vertical-align: top;
    }
    tbody tr:nth-child(even) {
      background: #fafafa;
    }
    tbody tr:hover {
      background: #f0f7ff;
    }
  </style>
</head>
<body>
  <header>
    <h2>AI助手问题单日报</h2>
    <div class="meta">生成时间：{{ now.strftime('%Y-%m-%d %H:%M:%S') }}</div>
  </header>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          {% for h in headers %}
          <th>{{ h }}</th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
        <tr>
          {% for h in headers %}
          <td>{{ row.get(h, '-') }}</td>
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</body>
</html>
